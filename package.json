{
  "name": "deg-studio",
  "version": "1.0.0",
  "description": "Firefly — 生信差异表达分析桌面客户端（Electron + React + R 内核）",
  "main": "./out/main/index.js",
  "author": "Lab Worm Team",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.mjs --no-error-on-unmatched-pattern",
    "test": "vitest run",
    "test:watch": "vitest",
    "assemble:r": "node scripts/assemble-r-runtime.mjs",
    "verify:r": "node scripts/verify-r-runtime.mjs",
    "verify:r-failures": "node scripts/smoke-r-failures.mjs",
    "walkthrough:ui": "node scripts/walkthrough-ui.mjs",
    "walkthrough:scrna-export": "node scripts/walkthrough-scrna-export.mjs",
    "walkthrough:statusbar": "node scripts/walkthrough-statusbar.mjs",
    "regress": "node scripts/regress.mjs",
    "regress:fast": "node scripts/regress.mjs --fast",
    "regress:ui": "node scripts/regress.mjs --ui",
    "regress:baseline": "node scripts/regress.mjs --baseline",
    "regress:all": "node scripts/regress.mjs --all",
    "gen:manifest": "node scripts/gen-r-libs-manifest.mjs",
    "gen:rice-annot": "node scripts/build-rice-annot.mjs",
    "check:rice-annot": "node scripts/build-rice-annot.mjs --check",
    "gen:rice-pathway": "node scripts/build-rice-pathway.mjs",
    "check:rice-pathway": "node scripts/build-rice-pathway.mjs --check",
    "smoke:scrna": "node scripts/smoke-scrna-import.mjs",
    "smoke:scrna-qc": "node scripts/smoke-scrna-qc.mjs",
    "smoke:scrna-prep": "node scripts/smoke-scrna-prep.mjs",
    "smoke:scrna-embed": "node scripts/smoke-scrna-embed.mjs",
    "smoke:scrna-markers": "node scripts/smoke-scrna-markers.mjs",
    "smoke:scrna-annotate": "node scripts/smoke-scrna-annotate.mjs",
    "smoke:scrna-custom-plots": "node scripts/smoke-scrna-custom-plots.mjs",
    "smoke:scrna-gene-query": "node scripts/smoke-scrna-gene-query.mjs",
    "smoke:scrna-import-object": "node scripts/smoke-scrna-import-object.mjs",
    "smoke:timeseries": "node scripts/smoke-timeseries-sam.mjs",
    "smoke:timeseries-moanin": "node scripts/smoke-timeseries-moanin.mjs",
    "gen:demo": "node scripts/gen-demo-data.mjs",
    "gen:demo:stress": "node scripts/gen-demo-data.mjs --genes 20000 --samples 48 --de 400 --out resources/demo-stress",
    "icon": "node scripts/gen-icon.mjs",
    "dist:dir": "npm run build && electron-builder --win --x64 --dir",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^5.15.20",
    "@mui/material": "^5.15.20",
    "@tanstack/react-table": "^8.17.3",
    "@tanstack/react-virtual": "^3.5.0",
    "chardet": "^2.0.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.11",
    "echarts": "^5.5.0",
    "electron-store": "^8.2.0",
    "exceljs": "^4.4.0",
    "iconv-lite": "^0.6.3",
    "jspdf": "^2.5.2",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0",
    "svg2pdf.js": "^2.9.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.14.9",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "cross-env": "^7.0.3",
    "electron": "^30.1.2",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^24.1.0",
    "playwright": "^1.45.0",
    "postcss": "^8.4.38",
    "rimraf": "^5.0.7",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vitest": "^1.6.0"
  }
}
